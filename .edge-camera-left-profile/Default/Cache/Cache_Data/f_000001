    function startExperimentTimer() {
      experimentStartTime = Date.now();
      clearInterval(experimentTimerInterval);
      experimentTimerInterval = setInterval(() => {
        const elapsed = Math.floor((Date.now() - experimentStartTime) / 1000);
        const mins = Math.floor(elapsed / 60);
        const secs = elapsed % 60;
        const etEl = $("elapsedTime"); if (etEl) etEl.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
