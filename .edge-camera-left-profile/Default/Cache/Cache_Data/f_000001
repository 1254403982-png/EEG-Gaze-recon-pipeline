    /* ===== Intro Page Logic ===== */
    const subjectInput = $("subjectId");
    const consentCheck = $("consentCheck");
    const startBtn = $("startExperimentBtn");

    function validateStart() {
      const hasId = subjectInput.value.trim().length > 0;
      const hasConsent = consentCheck.checked;
      startBtn.disabled = !(hasId && hasConsent);
    }
    subjectInput.addEventListener("input", validateStart);
    consentCheck.addEventListener("change", validateStart);

    startBtn.addEventListener("click", async () => {
      if (!startBtn.disabled) {
        // Config is already saved by researcher via the setup panel
        // (If researcher hasn't opened the panel, defaults apply)
        if (!config.bciServer) {
          config.bciServer = $("bciServer").value.trim().replace(/\/$/, "");
        }
        if (!config.apiKey) {
          config.apiKey = $("apiKeyInput").value.trim();
        }
        if (!config.vlModel) {
          config.vlModel = $("vlModelSelect").value;
        }
        console.log("Experiment starting with config:", { bci: config.bciServer || "(未配置，将不轮询)", ai: config.apiKey ? `${config.apiKey.slice(0,8)}...` : "(未配置，将用fallback)", model: config.vlModel });
        const subjectId = subjectInput.value.trim();
        state.condition = conditionOrder[0];
        await startPipelineSession(subjectId, state.condition);
        await syncPipelineUIContext("calibration");
        // 自动进入全屏（替代 F11）
        try { document.documentElement.requestFullscreen(); } catch (_) {}
        navigateTo("calibration");
        startCalibration();
        startDataPolling();
      }
    });

    /* ===== Calibration Logic ===== */
    let calInterval = null;
    let finishCalibration = null;
    function startCalibration() {
      // Clear any lingering timer from previous run
      if (calInterval) clearInterval(calInterval);
      if (state.pollTimer) clearInterval(state.pollTimer);

      // ★ 记录校准开始
      experimentData.calibration.startTime = Date.now();
      experimentData.calibration.startISO = new Date().toISOString();
      experimentData.calibration.loadSamples = [];

      // Detect real device connection status via /api/health
      checkCalDeviceStatus();

      const calibrationSeconds = 15;
      let remaining = calibrationSeconds;
      $("calTimer").textContent = remaining;
      $("calFill").style.width = "0%";

      finishCalibration = async function() {
        clearInterval(calInterval);
        calInterval = null;

        experimentData.calibration.endTime = Date.now();
        experimentData.calibration.endISO = new Date().toISOString();
        experimentData.calibration.durationSec =
          (experimentData.calibration.endTime - experimentData.calibration.startTime) / 1000;
        const calLoads = experimentData.calibration.loadSamples.map(s => s.value);
        if (calLoads.length > 0) {
          const calMean = calLoads.reduce((a,b)=>a+b,0) / calLoads.length;
          experimentData.calibration.baselineLoadAvg = Math.round(calMean);
          experimentData.calibration.baselineLoadStd = Math.round(Math.sqrt(calLoads.reduce((s,v)=>s+(v-calMean)**2,0)/calLoads.length));
        }
        experimentData.calibration.eegConnected = state.bciConnected;
        experimentData.calibration.eyeTrackerConnected = state.bciConnected;

        experimentData.meta.subjectId = $("subjectId")?.value || "unknown";
        experimentData.meta.background = $("subjectBg")?.value || "";
        experimentData.meta.experimentStartTime = Date.now();
        experimentData.meta.startISO = new Date().toISOString();
        experimentData.meta.bciServer = config.bciServer;
        experimentData.meta.vlModel = config.vlModel;
        experimentData.meta.trialOrder = [...trialOrder];
        experimentData.meta.conditionOrder = [...conditionOrder];

        // 同步 Condition 顺序 + UI
        state.condition = conditionOrder[0];
        $("explainButtons").style.display = "flex";
        $("chatInputArea").style.display = "grid";
        document.querySelectorAll(".explain-btn").forEach(b => b.classList.remove("is-active"));

        navigateTo("main");
        currentTrial = 0;
        loadTrial(0);
        startDataPolling();
        updateAiStatus();
        startExperimentTimer();
        startAutoSave();
        showToast("success", "校准完成，实验开始");
      }

      calInterval = setInterval(() => {
        remaining -= 1;
        $("calTimer").textContent = remaining;
        $("calFill").style.width =
          ((calibrationSeconds - remaining) / calibrationSeconds * 100) + "%";
        if (remaining <= 0) {
          finishCalibration();
        }
      }, 1000);
    }

    /* ===== Recon Pipeline data connection ===== */
    function setBciStatus(kind, label) {
      $("bciState").className = `status-pill is-${kind}`;
      $("bciState").textContent = label;
      state.bciConnected = kind === "live";
    }

    function setAiStatus(kind, label) {
      $("aiState").className = `status-pill is-${kind}`;
      $("aiState").textContent = label;
      state.aiConnected = kind === "live";
    }

    /* ===== Check Device Status for Calibration Page ===== */
    async function checkCalDeviceStatus() {
      const eegLamp = $("calEegLamp");
      const eegText = $("calEegText");
      const eyeLamp = $("calEyeLamp");
      const eyeText = $("calEyeText");

      if (!config.bciServer) {
        // No server configured → show warning state
        eegLamp.className = "quality-lamp is-warning";
        eegText.textContent = "脑电 ⚠️ 未配置";
        eyeLamp.className = "quality-lamp is-warning";
        eyeText.textContent = "眼动 ⚠️ 未配置";
        return;
      }

      try {
        const resp = await fetch(`${config.bciServer}/api/health`, { cache: "no-store" });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();

        // Refactored pipeline reports both modalities independently.
        const eegOk = data.eeg_connected === true;
        const eyeOk = data.gaze_connected === true || data.eyetracker_connected === true;

        eegLamp.className = `quality-lamp is-${eegOk ? "pass" : "warning"}`;
        eegText.textContent = eegOk ? "脑电 ✅ 已连接" : "脑电 ⚠️ 未连接";
        eyeLamp.className = `quality-lamp is-${eyeOk ? "pass" : "warning"}`;
        eyeText.textContent = eyeOk ? "眼动 ✅ 已连接" : "眼动 ⚠️ 未连接";

        // Also update main page BCI status
        setBciStatus(eegOk ? "live" : "error", eegOk ? "Live" : "Offline");
      } catch (err) {
        // Cannot reach Recon Pipeline → both devices show offline
        eegLamp.className = "quality-lamp is-warning";
        eegText.textContent = "脑电 ❌ 离线";
        eyeLamp.className = "quality-lamp is-warning";
        eyeText.textContent = "眼动 ❌ 离线";
        setBciStatus("error", "Offline");
      }
    }

    async function pollHealth() {
      if (!config.bciServer) { setBciStatus("idle", "Not Set"); return; }
      try {
        const resp = await fetch(`${config.bciServer}/api/health`, { cache: "no-store" });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        setBciStatus("live", "Live");
        const quality = data.eeg_quality || "unavailable";
        $("qualityLamp").className = `quality-lamp is-${quality === "pass" ? "pass" : "warning"}`;
        $("qualityStatus").textContent = quality === "pass" ? "Pass" : "Warning";
        $("qualityDetail").textContent = data.message || `EEG: ${quality}`;
      } catch (err) {
        setBciStatus("error", "Offline");
        $("qualityLamp").className = "quality-lamp is-warning";
        $("qualityStatus").textContent = "Warning";
        $("qualityDetail").textContent = "Recon Pipeline 服务未连接";
      }
    }

    async function pollAttention() {
      if (!config.bciServer || !state.bciConnected) return;
      try {
        const resp = await fetch(`${config.bciServer}/api/attention`, { cache: "no-store" });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        const load = data.attention_score ?? data.visual_load_index ?? data.score ?? null;
        const quality = data.quality_status || "pass";
        if (load != null) {
          const [band, bandLabel] = loadBand(load);
          state.load = load; state.quality = quality;
          $("loadCard").className = `metric-card is-${band}`;
          $("loadValue").textContent = Math.round(load);
          $("loadBand").textContent = bandLabel;
          $("qualityLamp").className = `quality-lamp is-${quality === "pass" ? "pass" : "warning"}`;
          $("qualityDetail").textContent = quality === "pass" ? "Signal accepted" : "Signal quality warning";
          state.history.push({ load, quality, time: Date.now() });
          state.history = state.history.slice(-160);
          updateBanner(band, quality);
          // Track load by difficulty for end page summary
          recordLoadByDifficulty(load);

          // ★ 存入当前试次的负荷采样
          const trial = currentTrialRecord();
          if (trial && trial.loadSamples) {
            const elapsedMs = Date.now() - trial.startTime;
            trial.loadSamples.push({ value: load, quality, timestamp: Date.now(), elapsedMs });
            trial.signalQuality.push({ quality, timestamp: Date.now() });
          }

          // ★ 如果在校准阶段，也存入校准数据
          if (state.currentPage === "calibration") {
            experimentData.calibration.loadSamples.push({ value: load, quality, timestamp: Date.now() });
          }
        }
      } catch (err) { console.warn("Attention poll failed:", err.message); }
    }

    function startDataPolling() {
      clearInterval(state.pollTimer);
      pollHealth();
      syncScreenLayout();
      state.pollTimer = setInterval(() => {
        pollHealth(); pollAttention(); pollPolicy(); syncScreenLayout();
      }, 1500);
    }

    async function syncScreenLayout() {
      if (state.currentPage !== "main" || state.inQuiz) return;
      const viewport = { width: window.innerWidth, height: window.innerHeight };
      const markers = [...document.querySelectorAll("[data-screen-marker]")].map(element => {
        const rect = element.getBoundingClientRect();
        return {
          id: Number(element.dataset.screenMarker),
          x_normalized: (rect.left + rect.width / 2) / viewport.width,
          y_normalized: (rect.top + rect.height / 2) / viewport.height,
        };
      });
      if (markers.length !== 4 || markers.some(marker => !Number.isFinite(marker.x_normalized))) return;
      const candidates = [
        $("readingTitle"),
        ...$("readingContent").querySelectorAll("h1,h2,h3,p,li,.formula-block,.data-table,table,tr"),
      ];
      const slide = currentTrial < trialOrder.length ? slides[trialOrder[currentTrial]] : null;
      const elements = candidates.flatMap((element, index) => {
        const rect = element?.getBoundingClientRect();
        if (!rect || rect.width < 2 || rect.height < 2 || rect.bottom <= 0 || rect.top >= viewport.height) return [];
        const xMin = Math.max(0, rect.left) / viewport.width;
        const yMin = Math.max(0, rect.top) / viewport.height;
        const xMax = Math.min(viewport.width, rect.right) / viewport.width;
        const yMax = Math.min(viewport.height, rect.bottom) / viewport.height;
        if (xMin >= xMax || yMin >= yMax) return [];
        return [{
          id: `slide-${slide?.id ?? "unknown"}-content-${index}`,
          tag: element.id || element.className || element.tagName.toLowerCase(),
          text: element.textContent.trim().replace(/\s+/g, " ").slice(0, 240),
          x_min: xMin, y_min: yMin, x_max: xMax, y_max: yMax,
        }];
      });
      try {
        await fetch(config.screenLayoutUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            page: "experiment",
            viewport,
            markers,
            elements,
            trial_id: `T${String(currentTrial + 1).padStart(2, "0")}`,
            slide_id: slide ? String(slide.id) : null,
          }),
        });
      } catch (_) {}
    }

    /* ===== Policy Polling (星妍端 → 前端自动触发) ===== */
    let lastPolicyLevel = "none";
    let lastPolicyTriggerTime = 0;
    async function pollPolicy() {
      if (state.condition < 2 || state.inQuiz) return;
      try {
        const resp = await fetch(config.policyUrl, { cache: "no-store" });
        if (!resp.ok) return;
        const data = await resp.json();
        if (data.cognitive_load != null) {
          const load = data.cognitive_load;
          const [band, bandLabel] = loadBand(load);
          state.load = load;
          $("loadCard").className = `metric-card is-${band}`;
          $("loadValue").textContent = Math.round(load);
          $("loadBand").textContent = bandLabel;
        }
        if (data.signal_quality) {
          const q = data.signal_quality;
          $("qualityLamp").className = `quality-lamp is-${q === "pass" ? "pass" : "warning"}`;
          $("qualityStatus").textContent = q === "pass" ? "Pass" : "Warning";
        }
        state._lastPolicyGaze = data.gaze_region || "";
        const level = data.explanation_level || "none";
        // 优先级：detailed > example > brief。更高优先级的立刻切换，同级等冷却
        const priority = { "brief": 1, "example": 2, "detailed": 3 };
        const currentPriority = priority[lastPolicyLevel] || 0;
        const newPriority = priority[level] || 0;
        const isUpgrade = newPriority > currentPriority;
        const isDifferent = level !== lastPolicyLevel;
        const cooldownOver = (Date.now() - lastPolicyTriggerTime) > 8000;

        const policyTriggered = level !== "none" && data.suppressed !== true && data.action !== "hold";
        if (policyTriggered && (isUpgrade || isDifferent || cooldownOver)) {
          lastPolicyLevel = level;
          lastPolicyTriggerTime = Date.now();
          triggerPolicyExplanation(level, { policy: data, source: "policy" });
          // 触发后立刻复位服务器，防止同一份数据重复触发
          fetch(config.policyUrl, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ explanation_level: "none", cognitive_load: 0, attention: 100, signal_quality: "pass" })
          }).catch(() => {});
        } else if (level === "none" && lastPolicyLevel !== "none") {
          lastPolicyLevel = "none";
          // 清除高亮和原文边框
          document.querySelectorAll(".explain-btn").forEach(b => b.classList.remove("is-active"));
          const readingEl = $("readingContent");
          if (readingEl) readingEl.style.boxShadow = "";
        }
      } catch (_) {}
    }

    let policyLLMBusy = false;
    let pendingPolicySuggestion = null;
    function escapeHtml(value) {
      const element = document.createElement("div");
      element.textContent = String(value ?? "");
      return element.innerHTML;
    }

    async function triggerPolicyExplanation(level, options = {}) {
      const map = { "brief": "简单解释", "example": "举例子", "detailed": "详细解释" };
      const uiLevel = map[level];
      if (!uiLevel) return;

      // 移除旧的 Policy 通知卡片（不堆积）
      const messagesEl = $("chatMessages");
      messagesEl.querySelectorAll(".policy-exchange.is-pending").forEach(c => c.remove());

      const slide = getCurrentSlideInfo();
      const calibratedFocus = options.policy?.target_aoi || state._lastPolicyGaze;
      const inferred = calibratedFocus ? null : await inferPolicyFocus(options.policy || {});
      const focus = calibratedFocus || inferred?.focus || `当前材料《${slide.title}》`;
      pendingPolicySuggestion = {
        level,
        policy: options.policy || {},
        source: options.source || "policy",
        focus,
        focusInference: inferred,
        previousManualLevel: state.lastExplainLevel,
        shownAt: Date.now(),
      };

      // Policy 只询问是否需要帮助，不在确认前调用 LLM。
      const card = document.createElement("div");
      card.className = "chat-msg-row is-ai policy-exchange is-pending";
      const levelNames = { "brief": "简单解释", "example": "举例子", "detailed": "详细解释" };
      const promptText = `你是不是对「${focus}」感到疑惑？我可以按${levelNames[level] || level}来帮助你。`;
      card.innerHTML = `<div class="chat-avatar-mini">AI</div><div class="chat-bubble">
        你是不是对「${escapeHtml(focus)}」感到疑惑？我可以按<b>${levelNames[level] || level}</b>来帮助你。
      </div>`;
      const responseRow = document.createElement("div");
      responseRow.className = "chat-msg-row is-user policy-exchange is-pending";
      responseRow.innerHTML = `<div class="chat-avatar-mini">U</div><div class="chat-bubble">
        <div class="policy-card-buttons">
          <button class="policy-card-btn" data-policy-response="accept">需要帮助</button>
          <button class="policy-card-btn is-dismiss" data-policy-response="reject">不需要</button>
        </div>
      </div>`;
      messagesEl.appendChild(card);
      messagesEl.appendChild(responseRow);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      pendingPolicySuggestion.promptCard = card;
      pendingPolicySuggestion.responseRow = responseRow;
      recordPolicyPrompt(pendingPolicySuggestion, promptText);
      responseRow.querySelector('[data-policy-response="accept"]').addEventListener("click", () => {
        acceptPolicySuggestion(responseRow);
      });
      responseRow.querySelector('[data-policy-response="reject"]').addEventListener("click", () => {
        rejectPolicySuggestion(responseRow);
      });

      // 底部解释按钮高亮推荐档位
      document.querySelectorAll(".explain-btn").forEach(b => {
        b.classList.remove("is-active");
        if (b.textContent.trim() === uiLevel) b.classList.add("is-active");
      });

      // 原文高亮闪烁（优先用 gaze_region 精准定位）
      const gaze = state._lastPolicyGaze || "";
      let targetEl = null;
      if (gaze) {
        // 尝试匹配 gaze_region 描述到具体元素
        const readingEl = $("readingContent");
        if (readingEl) {
          const allEls = readingEl.querySelectorAll("p, h3, .formula-block, .data-table");
          for (const el of allEls) {
            if (el.textContent.includes(gaze) || gaze.includes(el.textContent.slice(0, 20))) {
              targetEl = el;
              break;
            }
          }
          if (!targetEl) targetEl = readingEl; // fallback
        }
      } else {
        targetEl = $("readingContent");
      }
      if (targetEl) {
        targetEl.style.boxShadow = "inset 0 0 0 3px var(--amber)";
        targetEl.style.transition = "box-shadow 300ms ease";
        targetEl.scrollIntoView({ behavior: "smooth", block: "center" });
        setTimeout(() => {
          targetEl.style.boxShadow = "inset 0 0 0 3px transparent";
        }, 3000);
      }
    }

    async function inferPolicyFocus(policy) {
      try {
        const frameResponse = await fetch(config.gazeFrameUrl, { cache: "no-store" });
        if (!frameResponse.ok) return null;
        const frame = await frameResponse.json();
        if (frame.gaze?.x_normalized == null || frame.gaze?.y_normalized == null) {
          return null;
        }
        const mappedTarget = frame.screen_mapping?.valid ? frame.screen_mapping?.target : null;
        if (mappedTarget?.text) {
          return {
            focus: mappedTarget.text.slice(0, 60),
            frameTimestamp: frame.timestamp,
            frameAgeMs: frame.age_ms,
            gaze: frame.gaze,
            screenMapping: frame.screen_mapping,
          };
        }
        const slide = getCurrentSlideInfo();
        const material = $("readingContent")?.innerText?.trim().slice(0, 8000) || slide.summary;
        const prompt = `图中红色折线和黄色采样点表示被试最近一段时间的眼动轨迹，末端红色准星表示最新位置。请优先根据轨迹聚集、停留区域，而不是单一准星，结合场景图与下面的题目材料判断被试最可能持续查看的具体内容。只返回一个简短内容名称，不超过30个汉字；轨迹不足或无法判断时返回“当前材料”。\n\n标题：${slide.title}\n题目材料：${material}\n轨迹时间窗：${frame.trajectory_window_ms || 0} ms\n轨迹采样：${JSON.stringify(frame.trajectory || [])}\n最新坐标：${JSON.stringify(frame.gaze || {})}\nPolicy：${JSON.stringify(policy)}`;
        const data = await callAI(
          [{
            role: "user",
            content: [
              { type: "image_url", image_url: { url: frame.data_url } },
              { type: "text", text: prompt },
            ],
          }],
          { model: config.vlModel, temperature: 0.1, max_tokens: 80 },
        );
        const raw = data.choices?.[0]?.message?.content;
        const focus = String(raw || "").replace(/[\r\n"“”]/g, "").trim().slice(0, 60);
        if (!focus) return null;
        return {
          focus,
          frameTimestamp: frame.timestamp,
          frameAgeMs: frame.age_ms,
          gaze: frame.gaze,
          trajectorySamples: frame.trajectory?.length || 0,
          trajectoryWindowMs: frame.trajectory_window_ms || 0,
        };
      } catch (error) {
        console.warn("Policy focus inference failed:", error.message);
        return null;
      }
    }

    async function acceptPolicySuggestion(responseRow) {
      const suggestion = pendingPolicySuggestion;
      if (!suggestion) return;
      pendingPolicySuggestion = null;
      settlePolicyExchange(suggestion, responseRow, "需要帮助");
      recordPolicyResponse(suggestion, "accepted");
      await sendPolicyTriggeredMessage(suggestion);
    }

    function rejectPolicySuggestion(responseRow) {
      const suggestion = pendingPolicySuggestion;
      if (!suggestion) return;
      pendingPolicySuggestion = null;
      settlePolicyExchange(suggestion, responseRow, "不需要");
      recordPolicyResponse(suggestion, "rejected");
      restoreManualExplainLevel(suggestion.previousManualLevel);
      const readingEl = $("readingContent");
      if (readingEl) readingEl.style.boxShadow = "";
    }

    function settlePolicyExchange(suggestion, responseRow, answer) {
      suggestion.promptCard?.classList.remove("is-pending");
      responseRow.classList.remove("is-pending");
      const bubble = responseRow.querySelector(".chat-bubble");
      if (bubble) bubble.textContent = answer;
      const record = {
        role: "user",
        content: answer,
        timestamp: Date.now(),
        condition: state.condition,
        triggerSource: suggestion.source,
        messageType: "policy_response",
      };
      chatHistory.push(record);
      const trial = currentTrialRecord();
      if (trial) trial.chatMessages.push(record);
    }

    function recordPolicyPrompt(suggestion, content) {
      const record = {
        role: "assistant",
        content,
        timestamp: suggestion.shownAt,
        condition: state.condition,
        explainLevel: suggestion.level,
        triggerSource: suggestion.source,
        messageType: "policy_prompt",
      };
      chatHistory.push(record);
      const trial = currentTrialRecord();
      if (trial) trial.chatMessages.push(record);
    }

    function recordPolicyResponse(suggestion, response) {
      const trial = currentTrialRecord();
      if (!trial) return;
      trial.policySuggestions = trial.policySuggestions || [];
      trial.policySuggestions.push({
        level: suggestion.level,
        focus: suggestion.focus,
        focusInference: suggestion.focusInference,
        source: suggestion.source,
        response,
        policy: suggestion.policy,
        shownAt: suggestion.shownAt,
        respondedAt: Date.now(),
      });
    }

    function restoreManualExplainLevel(level) {
      state.lastExplainLevel = level || null;
      document.querySelectorAll(".explain-btn").forEach(button => {
        button.classList.toggle("is-active", button.dataset.level === state.lastExplainLevel);
      });
      updateSendButtonState();
    }

    async function sendPolicyTriggeredMessage(suggestion) {
      if (policyLLMBusy || state.currentPage !== "main") return;
      policyLLMBusy = true;
      const levelNames = { brief: "简单解释", example: "结合例子解释", detailed: "详细解释" };
      const slide = getCurrentSlideInfo();
      const prompt = `被试确认需要帮助。请结合最近一段时间的眼动轨迹场景帧和当前材料《${slide.title}》，围绕「${suggestion.focus}」提供${levelNames[suggestion.level] || "适当"}的解释。不要声称能够仅凭眼动轨迹确定用户的心理状态。`;
      try {
        await sendMessage({
          text: prompt,
          suppressUserBubble: true,
          suppressUserRecord: true,
          includeSceneFrame: true,
          source: suggestion.source,
          policy: suggestion.policy,
          explainLevel: suggestion.level,
        });
      } finally {
        policyLLMBusy = false;
        restoreManualExplainLevel(suggestion.previousManualLevel);
      }
    }

    async function manualPolicyTrigger() {
      try {
        const response = await fetch(`${_serverBase}/api/policy/evaluate`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}",
        });
        if (!response.ok) throw new Error(`Policy API ${response.status}`);
        const policy = await response.json();
        const level = policy.explanation_level && policy.explanation_level !== "none"
          ? policy.explanation_level
          : "brief";
        await triggerPolicyExplanation(level, { policy, source: "f10" });
      } catch (error) {
        addChatMsg("ai", `F10 触发失败：${error.message}`);
      }
    }

    function updateAiStatus() {
      if (!config.apiKey) {
        setAiStatus("live", "Backend");
      } else {
        setAiStatus("live", "Ready");
      }
    }

    /* ===== LaTeX Math Rendering ===== */
    function renderMathInElement(el) {
      if (!el || !window.katex) return;
      // Process block math $$...$$ first, then inline $...$
      const html = el.innerHTML;
      // $$...$$ → display math
      let processed = html.replace(/\$\$([\s\S]*?)\$\$/g, (_, formula) => {
        try { return katex.renderToString(formula.trim(), { displayMode: true, throwOnError: false }); }
        catch (e) { return `<span style="color:var(--red)">[Math Error]</span>`; }
      });
      // $...$ → inline math (skip $$ already processed)
      processed = processed.replace(/(?<!\$)\$(?!\$)([\s\S]*?)(?<!\$)\$(?!\$)/g, (_, formula) => {
        try { return katex.renderToString(formula.trim(), { displayMode: false, throwOnError: false }); }
        catch (e) { return `<span style="color:var(--red)">[Math Error]</span>`; }
      });
      el.innerHTML = processed;
    }

    /* ===== Trial Management ===== */
    function loadTrial(index) {
      pendingPolicySuggestion = null;
      state.inQuiz = false;
      setAIInteractionEnabled(true);
      document.querySelectorAll(".policy-exchange").forEach(card => card.remove());
      const slideIdx = trialOrder[index];
      const slide = slides[slideIdx];
      const trialRecord = createTrialRecord(index, slide);
      experimentData.trials.push(trialRecord);

      // Update HUD
      $("trialDisplay").textContent = `${index + 1} / 18`;
      $("domainLabel").textContent = slide.domain;
      $("difficultyChip").textContent = slide.difficulty;
      $("difficultyChip").className = `difficulty-chip ${slide.diffClass}`;
      $("domainTag").textContent = slide.domain;
      $("domainTag").className = `difficulty-chip ${slide.diffClass}`;
      $("diffTag").textContent = `${slide.difficulty}难度`;
      $("diffTag").className = `difficulty-chip ${slide.diffClass}`;
      $("trialIndexTag").textContent = `${index + 1} / 18`;

      fetch(`${_serverBase}/api/ui/context`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          trial_id: `T${String(index + 1).padStart(2, "0")}`,
          phase: "reading",
          slide_id: String(slideIdx),
          seconds_in_trial: 0,
          metadata: { domain: slide.domain, difficulty: slide.difficulty },
        }),
      }).catch((err) => console.warn("UI context sync failed:", err.message));

      // Update reading content
      $("readingTitle").textContent = slide.title;
      $("readingContent").innerHTML = slide.content;
      // 渲染 LaTeX 数学公式 $...$ 和 $$...$$
      renderMathInElement($("readingContent"));
      setTimeout(syncScreenLayout, 80);

      // Update progress
      const pfEl = $("progressFill"); if (pfEl) pfEl.style.width = `${((index + 1) / 18 * 100)}%`;
      const plEl = $("progressLabel"); if (plEl) plEl.textContent = `试次 ${index + 1}/18`;

      // Store quiz data for step-by-step display
      state._currentQuiz = slide.quiz;
      state._currentQuizIndex = 0;
      state._quizAnswers = [null, null];
    }

    function showQuizStep(step) {
      const quiz = state._currentQuiz;
      if (!quiz || step >= quiz.length) return;
      const q = quiz[step];
      const container = $("quizModal").querySelector(".quiz-body");
      container.innerHTML = `
        <p style="font-weight:850;font-size:17px;margin-bottom:14px;">第 ${step + 1} 题：${q.question}</p>
        <div class="quiz-options">
          ${q.options.map((opt, oi) => `<div class="quiz-option" onclick="selectOption(this, ${oi})">${opt}</div>`).join("")}
        </div>
      `;
      $("quizSubmitBtn").textContent = step < quiz.length - 1 ? "下一题" : "确认提交";
      $("quizSubmitBtn").disabled = true;
      state._currentQuizIndex = step;
    }

    function selectOption(el, optIndex) {
      el.parentElement.querySelectorAll(".quiz-option").forEach(o => o.classList.remove("is-selected"));
      el.classList.add("is-selected");
      state._quizAnswers[state._currentQuizIndex] = optIndex;
      $("quizSubmitBtn").disabled = false;
    }

    /* ===== Quiz Submit ===== */
    $("quizSubmitBtn").addEventListener("click", () => {
      const qi = state._currentQuizIndex;
      if (state._quizAnswers[qi] === null) return;

      const quiz = state._currentQuiz;
      if (qi < quiz.length - 1) {
        // 还有下一题
        showQuizStep(qi + 1);
      } else {
        // 最后一道题，结算
        const slideIdx = trialOrder[currentTrial];
        const slide = slides[slideIdx];
        const results = quiz.map((q, i) => ({
          question: q.question,
          selectedIndex: state._quizAnswers[i],
          correctIndex: q.answerIndex,
          isCorrect: state._quizAnswers[i] === q.answerIndex,
        }));
        const correctCount = results.filter(r => r.isCorrect).length;
        const isCorrect = correctCount >= 1;

        closeModal("quizModal");
        showToast(isCorrect ? "success" : "error", isCorrect ? `答对 ${correctCount}/${quiz.length} 题` : `答对 ${correctCount}/${quiz.length} 题`);

        quizResults.push({ slideId: slide.id, results, correctCount, isCorrect });
        const trial = currentTrialRecord();
        if (trial) {
          trial.endTime = Date.now();
          trial.endISO = new Date().toISOString();
          trial.durationSec = (trial.endTime - trial.startTime) / 1000;
          trial.quiz.results = results;
          trial.quiz.correctCount = correctCount;
          trial.quiz.isCorrect = isCorrect;
          trial.quiz.quizSubmitTime = Date.now();
          if (trial.quiz.quizOpenTime) {
            trial.quiz.responseTimeSec = (trial.quiz.quizSubmitTime - trial.quiz.quizOpenTime) / 1000;
          }
          const loads = trial.loadSamples.map(s => s.value);
          if (loads.length > 0) {
            trial.loadAvg = Math.round(loads.reduce((a,b)=>a+b,0) / loads.length);
            trial.loadMax = Math.round(Math.max(...loads));
            trial.loadMin = Math.round(Math.min(...loads));
            trial.loadStd = Math.round(Math.sqrt(loads.reduce((s,v)=>s+(v-trial.loadAvg)**2,0)/loads.length));
          }
          trial.chatCount = trial.chatMessages.length;
        }

        currentTrial++;
        if (currentTrial === 6 || currentTrial === 12) {
          const prevCond = currentTrial === 6 ? conditionOrder[0] : conditionOrder[1];
          showConditionQuestionnaire(prevCond, () => {
            showRestBreak(() => {
              switchCondition(conditionOrder[currentTrial === 6 ? 1 : 2]);
              loadTrial(currentTrial);
            });
          });
          return;
        }
        if (currentTrial >= 18) {
          clearInterval(state.pollTimer);
          clearInterval(experimentTimerInterval);
          const totalCorrect = quizResults.reduce((s, r) => s + r.correctCount, 0);
          const elapsedSecs = Math.floor((Date.now() - experimentStartTime) / 1000);
          const mins = Math.floor(elapsedSecs / 60);
          const secs = elapsedSecs % 60;
          $("endTrialCount").textContent = `${quizResults.length} / 18`;
          $("endAccuracy").textContent = `${Math.round(totalCorrect / (quizResults.length * 2) * 100)}%`;
          $("endTime").textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
          saveOnExperimentEnd();
          showConditionQuestionnaire(null, () => { navigateTo("questionnaire"); });
        } else {
          chatHistory.length = 0;
          apiContext.length = 0;
          state.lastExplainLevel = null;
          document.querySelectorAll(".explain-btn").forEach(b => b.classList.remove("is-active"));
          $("chatMessages").innerHTML = "";
          loadTrial(currentTrial);
        }
      }
    });

    $("nextBtn").addEventListener("click", () => {
