      console.log("Config saved:", { bci: config.bciServer || "(default)", ai: config.apiKey ? `${config.apiKey.slice(0,8)}...` : "(未配置)", model: config.vlModel, showDiff });
      showToast("success", "研究者配置已保存");
      // Update the intro-page banner
      closeResearcherPanel();
      // Re-check AI status if we're already on main page
      if (state.currentPage === "main") updateAiStatus();
    });
    // Also save config when clicking overlay backdrop
    $("researcherOverlay").addEventListener("click", (e) => {
      if (e.target === $("researcherOverlay")) closeResearcherPanel();
    });
    // Keyboard shortcut: Ctrl+Shift+S to open researcher panel
    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey && e.shiftKey && e.key === "S") {
        e.preventDefault();
        openResearcherPanel();
      }
    });




    /* ===== Trial Data (48 slides; each Condition gets 2 low + 2 medium + 2 high) ===== */
    /* ===== Trial Selection ===== */
    const TOTAL_QUESTIONS = 48;
    const CONDITION_COUNT = 3;
    const PER_DIFFICULTY_PER_CONDITION = 2;
    const lowIdx = slides.map((s, i) => i).filter(i => slides[i].difficulty === '低');
    const midIdx = slides.map((s, i) => i).filter(i => slides[i].difficulty === '中');
    const highIdx = slides.map((s, i) => i).filter(i => slides[i].difficulty === '高');

    function shuffleArray(values) {
      const shuffled = [...values];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }

    function buildBalancedTrialOrder() {
      const requiredPerDifficulty = CONDITION_COUNT * PER_DIFFICULTY_PER_CONDITION;
      const difficultyPools = [lowIdx, midIdx, highIdx].map((pool) => {
        if (pool.length < requiredPerDifficulty) {
          throw new Error(`题库数量不足：每个难度至少需要 ${requiredPerDifficulty} 道题`);
        }
        return shuffleArray(pool).slice(0, requiredPerDifficulty);
      });

      const conditionBlocks = [];
      for (let blockIndex = 0; blockIndex < CONDITION_COUNT; blockIndex++) {
        const start = blockIndex * PER_DIFFICULTY_PER_CONDITION;
        const end = start + PER_DIFFICULTY_PER_CONDITION;
        const balancedBlock = difficultyPools.flatMap((pool) => pool.slice(start, end));
        conditionBlocks.push(shuffleArray(balancedBlock));
      }

      const order = conditionBlocks.flat();
      validateBalancedTrialOrder(order);
      return order;
    }

    function validateBalancedTrialOrder(order) {
      const questionsPerCondition = PER_DIFFICULTY_PER_CONDITION * 3;
      if (order.length !== CONDITION_COUNT * questionsPerCondition) {
        throw new Error(`试次数量错误：应为 ${CONDITION_COUNT * questionsPerCondition} 题`);
      }
      if (new Set(order).size !== order.length) {
        throw new Error("试次生成错误：同一道题被重复抽取");
      }

      for (let blockIndex = 0; blockIndex < CONDITION_COUNT; blockIndex++) {
        const block = order.slice(
          blockIndex * questionsPerCondition,
          (blockIndex + 1) * questionsPerCondition,
        );
        const counts = { "低": 0, "中": 0, "高": 0 };
        block.forEach((slideIndex) => counts[slides[slideIndex].difficulty]++);
        if (counts["低"] !== 2 || counts["中"] !== 2 || counts["高"] !== 2) {
          throw new Error(`Condition 区块 ${blockIndex + 1} 的难度分配不平衡`);
        }
      }
    }

    let trialOrder = buildBalancedTrialOrder();
    let currentTrial = 0;

    /* ===== Utility Functions ===== */
    function recordLoadByDifficulty(loadValue) {
      if (currentTrial >= trialOrder.length) return;
      const slide = slides[trialOrder[currentTrial]];
      const diff = slide.difficulty === "低" ? "low" : slide.difficulty === "中" ? "moderate" : "high";
    }
    function updateDataPanelStatus() {
      const completed = experimentData.trials.length;
      const samples = experimentData.trials.reduce((s, t) => s + (t.loadSamples?.length || 0), 0);
      $("dataTrialCount").textContent = completed;
      $("dataLoadSamples").textContent = samples;
      $("dataChatCount").textContent = experimentData.trials.reduce((s, t) => s + (t.chatMessages?.length || 0), 0);
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) { $("dataStorageStatus").textContent = "OK"; $("dataStorageSize").textContent = Math.round(stored.length / 1024) + " KB"; }
      } catch (_) {}
    }
    function openQuestionnaire() { navigateTo("questionnaire"); }
    function rateLikert(btn, groupId) {
      document.querySelectorAll(`#${groupId} .likert-btn`).forEach(b => b.classList.remove("is-selected"));
      btn.classList.add("is-selected");
    }
    $("dataBtn").addEventListener("click", () => { openModal("dataModal"); drawEEGWaveform(); drawLoadTimeline(); updateDataPanelStatus(); });

    /* ===== Keyboard & Fullscreen ===== */
    document.addEventListener("keydown", (e) => {
      if (e.key === "F10" && !e.repeat && state.currentPage === "main" && !state.inQuiz) {
        e.preventDefault();
        manualPolicyTrigger();
        return;
      }
      if (e.ctrlKey && (e.key === "k" || e.key === "K")) {
        if (state.currentPage === "calibration" && typeof finishCalibration === "function") {
          e.preventDefault(); finishCalibration();
        }
      }
      if (state.currentPage !== "main") return;
      if (e.key === "ArrowRight") $("nextBtn").click();
    });
    document.addEventListener("dblclick", () => {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
    });
    $("fullscreenBtn").addEventListener("click", () => {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(() => {});
      else document.exitFullscreen();
    });
    document.querySelectorAll(".modal-overlay").forEach(overlay => {
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay && overlay.id !== "restModal") overlay.classList.remove("is-open");
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".modal-overlay.is-open").forEach(m => {
          if (m.id !== "restModal") m.classList.remove("is-open");
        });
      }
    });

    /* ===== EEG Canvas ===== */
    function drawEEGWaveform() {
      const canvas = $("eegCanvas"); if (!canvas) return;
      const ctx = canvas.getContext("2d"); const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h); ctx.fillStyle = "#fbfcfd"; ctx.fillRect(0, 0, w, h);
      const channels = ["P3", "P4", "PZ", "O1", "O2"];
      const colors = ["#12846f", "#245f9f", "#6b57a8", "#b56e09", "#c83f34"];
      const offsets = [0.2, 0.4, 0.6, 0.75, 0.9];
      channels.forEach((ch, i) => {
        ctx.strokeStyle = colors[i]; ctx.lineWidth = 1.8; ctx.beginPath();
        for (let x = 0; x < w; x++) {
          const y = h * offsets[i] + Math.sin(x * 0.08 + i * 2) * 18 + Math.sin(x * 0.22 + i) * 8 + Math.random() * 4;
          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke(); ctx.fillStyle = colors[i]; ctx.font = "700 10px Segoe UI"; ctx.fillText(ch, 6, h * offsets[i] - 10);
      });
    }
    function drawLoadTimeline() {
      const canvas = $("loadTimelineCanvas"); if (!canvas) return;
      const ctx = canvas.getContext("2d"); const w = canvas.width, h = canvas.height;
      const pad = { left: 34, right: 12, top: 12, bottom: 24 };
      const cw = w - pad.left - pad.right, ch = h - pad.top - pad.bottom;
      const yFor = (v) => pad.top + ch - (Math.max(0, Math.min(100, v)) / 100) * ch;
      ctx.clearRect(0, 0, w, h); ctx.fillStyle = "#fbfcfd"; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = "rgba(18,132,111,0.12)"; ctx.fillRect(pad.left, yFor(30), cw, yFor(0) - yFor(30));
      ctx.fillStyle = "rgba(181,110,9,0.15)"; ctx.fillRect(pad.left, yFor(70), cw, yFor(30) - yFor(70));
      ctx.fillStyle = "rgba(200,63,52,0.14)"; ctx.fillRect(pad.left, yFor(100), cw, yFor(70) - yFor(100));
      ctx.strokeStyle = "#d7e0e7"; ctx.lineWidth = 1;
      [0, 50, 100].forEach(tick => {
        ctx.beginPath(); ctx.moveTo(pad.left, yFor(tick)); ctx.lineTo(w - pad.right, yFor(tick)); ctx.stroke();
        ctx.fillStyle = "#657586"; ctx.font = "12px Segoe UI"; ctx.fillText(String(tick), 8, yFor(tick) + 4);
      });
      ctx.strokeStyle = "#c83f34"; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(pad.left, yFor(70)); ctx.lineTo(w - pad.right, yFor(70)); ctx.stroke();
      ctx.setLineDash([]);
      const simData = [];
      for (let i = 0; i < 60; i++) simData.push({ load: 35 + Math.sin(i * 0.15) * 25 + Math.random() * 10 });
      ctx.lineWidth = 3; ctx.strokeStyle = "#245f9f"; ctx.beginPath();
      const xFor = (i, n) => pad.left + (n <= 1 ? cw : (i / (n - 1)) * cw);
      simData.forEach((pt, i) => { const x = xFor(i, simData.length); const y = yFor(pt.load); if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); });
      ctx.stroke();
      simData.forEach((pt, i) => { const x = xFor(i, simData.length); const y = yFor(pt.load); ctx.fillStyle = "#12846f"; ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI * 2); ctx.fill(); });
    }

    /* ===== Initialize ===== */
    if (new URLSearchParams(window.location.search).get("screenMappingTest") === "1") {
      navigateTo("main");
      $("explainButtons").style.display = "flex";
      loadTrial(0);
      startDataPolling();
    } else {
      navigateTo("intro");
      validateStart();
    }
  </script>
