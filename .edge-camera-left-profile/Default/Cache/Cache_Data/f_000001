      chatHistory.length = 0;
      apiContext.length = 0;
      $("chatMessages").innerHTML = `<div class="chat-msg is-ai">你好！你可以随时向我提问关于当前阅读材料的问题。<div class="chat-msg-actions"><button class="feedback-btn" onclick="showToast('success','反馈已记录')">👍</button><button class="feedback-btn" onclick="showToast('info','反馈已记录')">👎</button></div></div><div class="typing-indicator" style="display:none;"><span class="typing-spinner"></span><span>AI 正在组织回答</span></div>`;
