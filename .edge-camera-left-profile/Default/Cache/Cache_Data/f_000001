    /* ===== Data Storage ===== */
    const STORAGE_KEY = "cogload_experiment_data";
    function saveToLocalStorage() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(experimentData)); } catch (e) {}
    }
    function computeSummary() {
      const s = experimentData.summary;
      s.totalTrials = experimentData.trials.length;
      const allResults = experimentData.trials.flatMap(t => t.quiz?.results || []);
      s.totalCorrect = allResults.filter(r => r.isCorrect).length;
      s.accuracy = s.totalTrials > 0 ? Math.round(s.totalCorrect / (s.totalTrials * 2) * 100) + "%" : "--";
      s.totalLoadSamples = experimentData.trials.reduce((a, t) => a + (t.loadSamples?.length || 0), 0);
      s.totalChatMessages = experimentData.trials.reduce((a, t) => a + (t.chatMessages?.length || 0), 0);
      if (experimentData.meta.experimentStartTime) {
        experimentData.meta.totalDurationSec = Math.floor((Date.now() - experimentData.meta.experimentStartTime) / 1000);
        experimentData.meta.experimentEndTime = Date.now();
        experimentData.meta.endISO = new Date().toISOString();
      }
    }
    function saveOnExperimentEnd() { computeSummary(); saveToLocalStorage(); }
    let autoSaveInterval = null;
    function startAutoSave() {
      if (autoSaveInterval) clearInterval(autoSaveInterval);
      autoSaveInterval = setInterval(() => saveToLocalStorage(), 15000);
    }
    function exportExperimentData() {
      computeSummary(); saveToLocalStorage();
      const blob = new Blob([JSON.stringify(experimentData, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `cogload_${experimentData.meta.subjectId || "unknown"}_${Date.now()}.json`;
      a.click(); URL.revokeObjectURL(url);
      showToast("success", "数据已导出");
    }
