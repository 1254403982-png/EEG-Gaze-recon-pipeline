      computeSummary();
      const payload = { subjectId: experimentData.meta.subjectId || "unknown", experimentData };
      try { await fetch(config.dataCollectorUrl, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) }); } catch (_) {}
      saveToLocalStorage(); navigateTo("end"); showToast("success", "实验结束");
