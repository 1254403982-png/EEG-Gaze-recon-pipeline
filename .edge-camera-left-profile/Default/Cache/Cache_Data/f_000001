    // 创建单试次数据模板
    function createTrialRecord(trialIndex, slide) {
      return {
        // 试次基本信息
        trialIndex,                   // 0-17
        slideId: slide.id,
        title: slide.title,
        domain: slide.domain,
        difficulty: slide.difficulty,
        condition: state.condition,

        // 时间记录
