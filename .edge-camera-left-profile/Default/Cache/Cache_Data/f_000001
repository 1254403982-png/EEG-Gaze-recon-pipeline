    /* ===== Exit Experiment (from pause modal) ===== */
    function exitExperiment() {
      clearInterval(state.pollTimer);
      clearInterval(experimentTimerInterval);
      closeModal("pauseModal");
      navigateTo("end");
    }

    /* ===== Experiment Reset (for re-entering after completion) ===== */
    function resetExperiment() {
      // Stop all timers
      clearInterval(state.pollTimer);
      clearInterval(calInterval);
      clearInterval(experimentTimerInterval);
      state.pollTimer = null;
      calInterval = null;
      experimentTimerInterval = null;

      // Reset state
      state.load = null;
      state.quality = "waiting";
      state.history = [];
      state.bciConnected = false;
      state.aiConnected = false;

      // Reset statistics
      quizResults.length = 0;
      experimentStartTime = null;

