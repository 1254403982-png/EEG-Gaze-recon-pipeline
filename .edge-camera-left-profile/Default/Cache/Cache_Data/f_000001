    async function sendMessage(options = {}) {
      const text = options.text || $("chatInput").value.trim();
      if (!text) return;
      if (state.inQuiz) return;
      if (state.aiBusy) return;
      if (!options.source && !["简单解释", "举例子", "详细解释"].includes(state.lastExplainLevel)) {
        showToast("info", "请先选择解释难度");
        return;
      }
      const selectedLevel = options.explainLevel || state.lastExplainLevel;
      const displayText = options.displayText || (
        options.source ? text : `${selectedLevel}：${text}`
      );
      if (!options.suppressUserBubble) addChatMsg("user", displayText);
      $("chatInput").value = "";
      state.aiBusy = true;
      updateSendButtonState();
      const typing = ensureTypingIndicator();
      typing.style.display = "flex";
      $("chatMessages").scrollTop = $("chatMessages").scrollHeight;

      // ★ 记录用户消息到数据存储
      const userMsgRecord = {
        role: "user", content: displayText, requestContent: text, timestamp: Date.now(),
        condition: state.condition,
        explainLevel: selectedLevel,
        triggerSource: options.source || "manual",
        policy: options.policy || null,
      };
      if (!options.suppressUserRecord) chatHistory.push(userMsgRecord);
      const trial = currentTrialRecord();
      if (trial && !options.suppressUserRecord) trial.chatMessages.push(userMsgRecord);
      // ★ 同时加入API上下文（严格交替）
      apiContext.push({ role: "user", content: text });

      try {
        const response = await callQwenVL(text, {
          includeSceneFrame: options.includeSceneFrame === true,
          policy: options.policy || null,
          explainLevel: selectedLevel,
        });
        if (typing) typing.style.display = "none";
        addChatMsg("ai", response);
        setAiStatus("live", "Live");
        const aiMsgRecord = {
          role: "assistant", content: response, timestamp: Date.now(),
          condition: state.condition,
          explainLevel: selectedLevel,
        };
        chatHistory.push(aiMsgRecord);
        if (trial) trial.chatMessages.push(aiMsgRecord);
        apiContext.push({ role: "assistant", content: response });
      } catch (err) {
        if (typing) typing.style.display = "none";
        let errDisplay = err.message;
        if (err.message.includes("Failed to fetch") || err.message.includes("NetworkError") || err.name === "TypeError") {
          errDisplay = "网络连接失败，可能是代理或API Key没启动。请先启动本地代理，再确认环境变量。";
        }
        const errMsg = `⚠️ AI调用失败: ${errDisplay}`;
        addChatMsg("ai", errMsg);
        setAiStatus("error", "Error");
        const errRecord = { role: "assistant", content: errMsg, timestamp: Date.now(), isError: true };
        chatHistory.push(errRecord);
        if (trial) trial.chatMessages.push(errRecord);
        apiContext.pop();
        console.error("QwenVL call failed:", err);
      }
      state.aiBusy = false;
      updateSendButtonState();
    }

    // ===== AI API 调用（与 UI 解耦，换模型只改这里）=====
    // 此函数负责所有 API 通信，UI 层只管组装 messages 和显示回复
    // 后端 server.py 转发到阿里云百炼 DashScope 兼容接口
    async function callAI(messages, opts = {}) {
      // 演示模式：不走真实 API，直接返回本地预设答案
      if (DEMO_AI_MODE) {
        const demoReply = buildDemoAIReply(messages);
        return {
          id: `demo-${Date.now()}`,
          object: "chat.completion",
          model: opts.model || config.vlModel,
          choices: [
            {
              index: 0,
              message: { role: "assistant", content: demoReply },
              finish_reason: "stop",
            },
          ],
          usage: {
            prompt_tokens: 0,
            completion_tokens: demoReply.length,
            total_tokens: demoReply.length,
          },
        };
      }

      const {
        model = config.vlModel,
        temperature = 0.7,
        max_tokens = 2000,
        apiKey = config.apiKey,
      } = opts;

      const payload = { model, messages, temperature, max_tokens };
      console.log("callAI:", { model, msgCount: messages.length, roles: messages.map(m => m.role) });

      const headers = { "Content-Type": "application/json" };
      if (apiKey) headers.Authorization = `Bearer ${apiKey}`;

      const response = await fetch(config.vlApiUrl, {
        method: "POST",
        headers,
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        let errDetail = "";
        try { errDetail = await response.text(); } catch (_) { errDetail = `(status ${response.status})`; }
        // 尝试解析 JSON 错误信息
        let errMsg = errDetail;
        try { errMsg = JSON.parse(errDetail)?.error?.message || errMsg; } catch (_) {}
        throw new Error(`API错误 ${response.status}: ${errMsg.slice(0, 300)}`);
      }

      return await response.json();
    }

    // ===== 构建对话上下文并调用 AI =====
    async function callQwenVL(userMessage, options = {}) {
      const slide = getCurrentSlideInfo();
      const levelNames = { brief: "简单解释", example: "举例子", detailed: "详细解释" };
      const explainLevel = levelNames[options.explainLevel] || options.explainLevel || state.lastExplainLevel;
      const levelContracts = {
        "简单解释": "只用1至2句直接解释核心含义，总长度不得超过80个中文字符。严禁举例、类比、假设场景和扩展知识。",
        "举例子": "先用一句话说明核心含义，再只给出一个紧贴原文的例子。",
        "详细解释": "使用编号步骤，从定义和前提开始，一步一步拆解推理，每一步只讲一个小点。严禁举例、类比和假设场景。",
      };
      const explainHint = explainLevel
        ? `\n解释档位：${explainLevel}\n硬性要求：${levelContracts[explainLevel] || "直接回答被试问题。"}`
        : "";
      const systemPrompt = `你是一个认知负荷实验的阅读助手。当前材料：
标题：${slide.title} | 领域：${slide.domain} | 难度：${slide.difficulty}
摘要：${slide.summary}
认知负荷：${state.load != null ? Math.round(state.load) + '/100' : '未知'}${state.load != null && state.load > 70 ? '(较高，请降低句子复杂度)' : ''}${explainHint}
必须严格遵守所选解释档位。除“举例子”档位外，不得出现“例如、比如、譬如、举例、打个比方”等内容。可使用Markdown，但不要加入与原文无关的信息。`;

      // 取最近6轮对话（12条消息），但明确把本次 userMessage 作为最后一条
      const contextSlice = apiContext.slice(0, -1).slice(-11);

      // 双重保险：强制验证交替
      const validatedMessages = [];
      for (let i = 0; i < contextSlice.length; i++) {
        const msg = contextSlice[i];
        const expectedRole = i % 2 === 0 ? "user" : "assistant";
        if (msg.role !== expectedRole) {
          console.warn(`apiContext alternation broken at index ${i}: expected ${expectedRole}, got ${msg.role}. Truncating.`);
          break;
        }
        validatedMessages.push({ role: msg.role, content: msg.content });
      }
      // 确保历史部分最后一条是 assistant，避免把未完成的 user 留到上下文里
      if (validatedMessages.length > 0 && validatedMessages[validatedMessages.length - 1].role !== "assistant") {
        validatedMessages.pop();
      }

      let currentUserContent = userMessage;
      if (options.includeSceneFrame) {
        const frameResponse = await fetch(config.gazeFrameUrl, { cache: "no-store" });
        if (!frameResponse.ok) throw new Error(`眼动场景帧不可用 (${frameResponse.status})`);
        const frame = await frameResponse.json();
        currentUserContent = [
          { type: "image_url", image_url: { url: frame.data_url } },
          { type: "text", text: `${userMessage}\nPolicy: ${JSON.stringify(options.policy || {})}\n场景帧时间: ${frame.timestamp?.utc || "unknown"}; 帧年龄: ${Math.round(frame.age_ms || 0)} ms; 眼动轨迹时间窗: ${Math.round(frame.trajectory_window_ms || 0)} ms; 有效轨迹采样数: ${frame.trajectory?.length || 0}` },
        ];
      }

      const messages = [
        { role: "system", content: systemPrompt },
        ...validatedMessages,
        { role: "user", content: currentUserContent },
      ];

      // 调用 callAI（API 逻辑与 UI 逻辑分离）
      const maxTokens = explainLevel === "简单解释" ? 120 : explainLevel === "详细解释" ? 900 : 450;
      const data = await callAI(messages, { max_tokens: maxTokens, temperature: 0.35 });
      const reply = data.choices?.[0]?.message?.content || "（模型未返回有效回复）";
      return enforceExplanationContract(reply, explainLevel);
    }

    function enforceExplanationContract(reply, explainLevel) {
      let cleaned = String(reply || "").trim();
      if (["简单解释", "详细解释"].includes(explainLevel)) {
        cleaned = cleaned.replace(
          /[^。！？\n]*(?:例如|比如|譬如|举例|打个比方|假设一个)[^。！？\n]*[。！？\n]?/g,
          "",
        ).trim();
      }
      if (explainLevel === "简单解释") {
        cleaned = cleaned.replace(/[*_#`>-]/g, "").replace(/\s+/g, " ").trim();
        const characters = Array.from(cleaned);
        if (characters.length > 80) cleaned = `${characters.slice(0, 79).join("")}…`;
      }
      return cleaned || "当前回答未满足所选解释档位，请重新发送。";
    }

    function ensureTypingIndicator() {
