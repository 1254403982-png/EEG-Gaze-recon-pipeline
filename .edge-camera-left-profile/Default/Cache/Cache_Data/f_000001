    /* ===== Rest Break (5min countdown) ===== */
    function showRestBreak(callback) {
      syncPipelineUIContext("rest");
      openModal("restModal");
      let remaining = 300; // 5分钟 = 300秒
      const timerEl = $("restTimer");
      const skipBtn = $("restSkipBtn");
      timerEl.textContent = "5:00";
      timerEl.classList.add("is-running");

      const tick = () => {
        remaining--;
        const mins = Math.floor(remaining / 60);
        const secs = remaining % 60;
        timerEl.textContent = `${mins}:${secs.toString().padStart(2, "0")}`;
        if (remaining <= 0) { finish(); }
      };

      const finish = () => {
        clearInterval(restInterval);
        timerEl.classList.remove("is-running");
        closeModal("restModal");
        if (callback) callback();
      };

      let restInterval = setInterval(tick, 1000);

      // 提前继续
      skipBtn.onclick = () => finish();
    }

