    const $ = (id) => document.getElementById(id);

    /* ===== Page Navigation ===== */
    function navigateTo(page) {
      const pages = { intro: "introPage", calibration: "calibrationPage", main: "mainPage", end: "endPage", questionnaire: "questionnairePage" };
      Object.values(pages).forEach(id => $(id).style.display = "none");
