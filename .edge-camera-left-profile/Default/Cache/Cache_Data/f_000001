    function generateFallbackResponse(question) {
      const responses = {
        "68-95-99.7规则": "68-95-99.7规则是正态分布的核心性质：约68%的数据在μ±1σ内，约95%在μ±2σ内，约99.7%在μ±3σ内。",
        "Z变换的用途": "Z变换将任意正态分布标准化为Z分布(μ=0,σ=1)，公式Z=(X-μ)/σ。用于假设检验和置信区间。",
        "给我出道练习题": "练习题：某校身高均值170cm,σ=5cm。身高>180cm概率约多少？(Z=2, P≈2.27%)",
        "用通俗语言解释": "正态分布像钟形山：山顶=均值，宽度=标准差。σ大→矮胖山，σ小→高瘦山。",
      };
      return responses[question] || `关于"${question}"，请配置 Qwen VL API Key 以获得更智能的回答。`;
    }
    function buildDemoAIReply(messages) {
      const lastUserMessage = [...messages].reverse().find(m => m.role === "user")?.content || "";
      const slide = getCurrentSlideInfo();
      const question = lastUserMessage.trim();

      const canned = {
        "核心概念": `当前材料《${slide.title}》的核心概念可以概括为：${slide.summary}`,
        "总结要点": `要点可以直接记成一句话：${slide.summary}`,
        "用通俗语言解释": `可以把它理解成：${slide.summary}。简单说，就是把复杂内容压缩成最关键的一层意思。`,
        "给我出道练习题": `练习题：基于《${slide.title}》，你可以先回答一个最关键的问题：${slide.summary}。如果要我继续，我还能给你出选择题。`,
        "讲得更清楚点": `换个更清楚的说法：${slide.summary}`,
        "再简单一点": `再简单一点说：${slide.summary}`,
        "为什么": `结合当前材料《${slide.title}》，原因可以这样理解：${slide.summary}`,
      };

      if (canned[question]) return canned[question];
      if (question.includes("练习题")) {
        return `练习题：请结合《${slide.title}》自己复述一遍核心意思。标准答案的方向是：${slide.summary}`;
      }
      if (question.includes("通俗") || question.includes("解释")) {
        return `通俗地说，《${slide.title}》主要想表达的是：${slide.summary}`;
      }
      if (question.includes("总结") || question.includes("要点")) {
        return `总结一下：《${slide.title}》的重点就是：${slide.summary}`;
      }
      if (question.includes("区别") || question.includes("对比")) {
        return `从当前材料看，可以把它理解成“概念A更偏${slide.summary}”。如果需要，我可以继续按对比表的方式讲。`;
      }
      return `结合当前材料《${slide.title}》，这个问题可以先这样回答：${slide.summary}`;
    }

